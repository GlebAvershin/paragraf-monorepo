{
  "name": "@ourapp/doc-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Document parsers (PDF/DOCX/XLSX) and DOCX generator. Used as an opencode plugin in the desktop fork.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
