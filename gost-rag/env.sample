# Copy to .env  ->  cp env.sample .env

# ============ МАРШРУТИЗАЦИЯ ============
# Всё (генерация, судья, агенты, эмбеддинги) идёт через ОДИН LiteLLM-шлюз (paragraf-gateway),
# а внутри шлюза — OpenRouter (твой ключ), GigaChat (отдельный ключ) и т.д. Сам OPENROUTER_API_KEY
# живёт в .env ШЛЮЗА, не здесь. Ключ ниже — virtual-key шлюза (./scripts/create-test-key.sh)
# или master-key для локальной разработки.
LLM_PROVIDER=litellm
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-...

# --- эмбеддинги тоже через шлюз (модель = алиас из litellm-config.yaml) ---
EMBEDDINGS_BASE_URL=http://localhost:4000
EMBEDDINGS_API_KEY=sk-...                 # тот же ключ шлюза, что и LITELLM_API_KEY
EMBEDDINGS_MODEL=qwen/qwen3-embedding-8b
EMBEDDINGS_DIM=4096                        # нативная размерность Qwen3-Embedding-8B

# ─────────── Альтернатива: без шлюза, напрямую в OpenRouter (zero-infra) ───────────
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1   # ключ берётся из OPENROUTER_API_KEY
# ───────────────────────────────────────────────────────────────────────────────────

# ---- Optional Langfuse tracing (no-op unless both keys set AND `uv sync --extra trace`) ----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gost

# ---- Native reranker (Stream D2) — OpenAI/Cohere-style /rerank, e.g. Qwen3-Reranker on vLLM ----
# Only used by the `rerank: native` ablation. vLLM:  vllm serve Qwen/Qwen3-Reranker-8B --task score
RERANK_BASE_URL=http://localhost:8001
RERANK_API_KEY=EMPTY
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# ---- Default models (gateway aliases; they mirror OpenRouter ids, so they work either way) ----
GEN_MODEL=qwen/qwen3-8b
JUDGE_MODEL=qwen/qwen3-8b
