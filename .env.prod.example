# Isaak — production env для docker-compose.prod.yml (весь монорепо: web+engine+billing
# на одном YC-сервере). Скопировать в .env.prod, заполнить, НИКОГДА не коммитить.
#
# Секреты нужно сгенерировать ОДИН раз и продублировать там же, где указано "ДОЛЖЕН
# совпадать с" — иначе JWT verify/gateway-гейт откажут не с понятной ошибкой, а с 401.
#
# Миграция на YC Lockbox/Secret Manager (когда будет доступ): секреты ниже — кандидаты
# на перенос как есть (имя переменной = имя секрета в Lockbox). См.
# scripts/env-from-yc-lockbox.sh — заготовка-скрипт, подтягивает .env.prod из Lockbox
# перед `docker compose up`, не требует переписывать compose-файлы.

# === Домен / TLS ===
APP_DOMAIN=app.isaac-ai.ru
ACME_EMAIL=admin@isaac-ai.ru

# === Postgres — ДВА отдельных инстанса (billing хранит ПДн, engine хранит сырую
# историю чатов — оба тоже ПДн, 152-ФЗ; разделены для независимой ротации/бэкапа) ===
BILLING_POSTGRES_PASSWORD=__GENERATE_openssl_rand_base64_32__
ENGINE_POSTGRES_PASSWORD=__GENERATE_openssl_rand_base64_32__

# === Auth (JWT) — ОДНО значение, billing выпускает + verify'ит, engine только verify'ит ===
JWT_SECRET=__GENERATE_openssl_rand_hex_64__
JWT_ISSUER=billing.local
JWT_AUDIENCE=ourapp-desktop

# === Публичный URL сайта (для email-ссылок, CORS-allowlist engine/billing) ===
APP_PUBLIC_URL=https://app.isaac-ai.ru

# === Gateway (paragraf-gateway, отдельный репо, ТОТ ЖЕ сервер, loopback-only) ===
# LiteLLM/gateway-app публично НЕ выставляются — engine достаёт их по 127.0.0.1
# (host.docker.internal внутри контейнеров). Если gateway когда-нибудь переедет
# на отдельный сервер — заменить на публичный https://gateway.isaac-ai.ru.
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_MASTER_KEY=__СОВПАДАЕТ_С_paragraf-gateway/.env.prod_LITELLM_MASTER_KEY__
ANSWER_URL=http://host.docker.internal:4100
# ДОЛЖЕН побайтово совпадать с GATEWAY_API_SECRET в paragraf-gateway/.env.prod —
# движок шлёт его заголовком X-Internal-Key, шлюз проверяет.
GATEWAY_API_SECRET=__СОВПАДАЕТ_С_paragraf-gateway/.env.prod_GATEWAY_API_SECRET__

# === SMTP — Yandex Cloud Postbox (OTP-коды + уведомления, РФ-инфра, 152-ФЗ) ===
# 1) создать ресурс Postbox; 2) верифицировать домен-отправитель (SPF+DKIM+DMARC
#    в зоне isaac-ai.ru); 3) вывод из sandbox; 4) сервисный аккаунт роль postbox.sender;
#    5) API-ключ scope yc.postbox.send. SMTP_USER = ID ключа, SMTP_PASSWORD = секрет.
# НЕ личная Яндекс.Почта (smtp.yandex.ru — бесплатный SMTP отключают 29.06.2026).
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Isaak <noreply@isaac-ai.ru>"

# === CloudPayments (платежи) — без них /payments/* корректно отдают 503 ===
CLOUDPAYMENTS_PUBLIC_ID=pk_...
CLOUDPAYMENTS_API_SECRET=...
CLOUDPAYMENTS_WEBHOOK_SECRET=__GENERATE_openssl_rand_hex_32__

# === S3 для бэкапов БД (scripts/backup.sh) — ТОЛЬКО РФ-хостинг (152-ФЗ) ===
# Selectel S3 / Yandex Object Storage — НЕ зарубежные провайдеры.
BACKUP_S3_ENDPOINT=https://s3.storage.selcloud.ru
BACKUP_S3_BUCKET=isaak-db-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

LOG_LEVEL=info
