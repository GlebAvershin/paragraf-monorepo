# Billing service configuration.
# Copy to .env and fill in real values. DO NOT commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database (Postgres in RU jurisdiction for 152-ФЗ compliance) ---
DATABASE_URL=postgres://billing:billing@localhost:5433/billing

# --- Session JWT signing ---
# Generate: openssl rand -hex 64
JWT_SECRET=

# Issuer / audience (your domain).
JWT_ISSUER=billing.ourapp.com
JWT_AUDIENCE=ourapp-desktop

# Magic-link token validity (minutes).
MAGIC_LINK_TTL_MINUTES=15

# --- LiteLLM Gateway ---
# Hosted abroad (Hetzner). Internal URL — Billing -> Gateway management API.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# --- Email (SMTP) ---
# Три режима:
#  1) DEV-консоль:    SMTP_HOST пустой -> OTP-коды и письма ПЕЧАТАЮТСЯ в лог billing.
#  2) DEV-Mailpit:    SMTP_HOST=127.0.0.1 SMTP_PORT=1025 (без auth) -> письма ловит
#                     контейнер mailpit, смотреть на http://localhost:8025
#                     (`docker compose up -d` в billing/ поднимает его).
#                     ВАЖНО: именно 127.0.0.1, НЕ localhost — Bun на Windows не
#                     резолвит localhost для SMTP (DNSException ETIMEOUT).
#  3) PROD:           реальный провайдер (РФ-инфра + 152-ФЗ). РЕКОМЕНДАЦИЯ —
#                     Yandex Cloud Postbox (транзакционный сервис, 2000 писем/мес
#                     бесплатно, дальше дёшево). SMTP-эндпоинт и логин/пароль (IAM/
#                     сервисный аккаунт) берутся в консоли Yandex Cloud Postbox:
#                       SMTP_HOST=<из консоли Postbox>  SMTP_PORT=587 (STARTTLS) или 465 (TLS)
#                       SMTP_USER=<key id>  SMTP_PASSWORD=<secret>
#                       SMTP_FROM=noreply@вашдомен  (домен должен быть верифицирован в Postbox)
#                     НЕ использовать личную Яндекс.Почту: с 29.06.2026 Яндекс
#                     отключает бесплатный SMTP для Почты. Yandex 360 — платный.
#                     Альтернативы: Mailopost / SMTP.bz / Unisender Go.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ourapp.com

# Magic-link landing page (where /auth/verify is exposed for clicks).
APP_PUBLIC_URL=http://localhost:3000

# --- CloudPayments (acquiring — ТЗ-02) ---
# Получить в личном кабинете CloudPayments (тест-режим — отдельный кабинет).
# В dev можно оставить пустыми — платёжные эндпоинты вернут 503.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Секрет для проверки HMAC-подписи webhook'ов (Content-HMAC).
# Если не задан — используется CLOUDPAYMENTS_API_SECRET.
CLOUDPAYMENTS_WEBHOOK_SECRET=
# Боевой API: https://api.cloudpayments.ru
CLOUDPAYMENTS_API_URL=https://api.cloudpayments.ru

# --- Внутренняя админ-панель разработчиков (/admin/users) ---
# ОДНО значение, совпадающее с engine/.env ADMIN_TOKEN. Пусто ⇒ /admin/* отключены (503).
ADMIN_TOKEN=
