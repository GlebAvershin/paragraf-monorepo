# Billing production env (ТЗ-06).
# Скопировать в .env.prod, заполнить, НИКОГДА не коммитить.
# ВАЖНО: ПДн пользователей хранятся в Postgres этого хоста — деплоить ТОЛЬКО в РФ.

# === Caddy / TLS ===
BILLING_DOMAIN=api.paragraf.ru
ACME_EMAIL=admin@paragraf.app

# === Сам сервис ===
APP_PUBLIC_URL=https://app.paragraf.ru
LOG_LEVEL=info

# === Postgres (ПДн!) — внутренний ===
POSTGRES_PASSWORD=__GENERATE_openssl_rand_base64_32__

# === Redis (idempotency, rate-limit) ===
REDIS_PASSWORD=__GENERATE_openssl_rand_base64_32__

# === Auth (JWT) ===
JWT_SECRET=__GENERATE_openssl_rand_base64_64__

# === Gateway (LiteLLM) — зарубежный VPS ===
LITELLM_BASE_URL=https://gateway.paragraf-llm.com
# Master key выпущен на gateway-VPS в .env.prod там же. КРИТИЧНО: Никогда не
# попадает в desktop-сборку.
LITELLM_MASTER_KEY=sk-...

# === SMTP — Yandex Cloud Postbox (OTP-коды + уведомления) ===
# Транзакционный сервис, 2000 писем/мес бесплатно, РФ-инфра (152-ФЗ).
# Настройка в консоли Yandex Cloud:
#   1) создать ресурс Postbox; 2) верифицировать домен-отправитель (SPF+DKIM+DMARC
#      DNS-записи в зоне paragraf.ru); 3) запросить вывод из sandbox (production access);
#   4) сервисный аккаунт с ролью postbox.sender; 5) API-ключ со scope yc.postbox.send.
# SMTP_USER = ID API-ключа, SMTP_PASSWORD = секрет API-ключа.
# НЕ личная Яндекс.Почта (smtp.yandex.ru) — её бесплатный SMTP отключают 29.06.2026.
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Параграф <noreply@paragraf.ru>"

# === CloudPayments ===
CLOUDPAYMENTS_PUBLIC_ID=pk_...
CLOUDPAYMENTS_API_SECRET=...
CLOUDPAYMENTS_WEBHOOK_SECRET=__GENERATE_openssl_rand_hex_32__

# === S3 для бэкапов ПДн (ТОЛЬКО РФ-хостинг!) ===
# Selectel S3 / Yandex Object Storage — НЕ зарубежные провайдеры.
BACKUP_S3_ENDPOINT=https://s3.storage.selcloud.ru
BACKUP_S3_BUCKET=paragraf-billing-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
