{
  "name": "@ourapp/billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "worker:retry": "bun run src/worker/recurrent-retry.ts",
    "worker:retry:loop": "bun run src/worker/recurrent-retry.ts --loop",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push --force",
    "db:seed": "bun run src/db/seed.ts",
    "create-user": "bun run src/scripts/create-user.ts",
    "grant-credits": "bun run src/scripts/grant-credits.ts",
    "sync-model-access": "bun run src/scripts/sync-model-access.ts",
    "test": "bun run test/run-tests.ts",
    "test:payments": "bun run test/run-tests.ts test/payments-flow.test.ts",
    "test:e2e": "bun run test/run-tests.ts test/e2e-golden.test.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "jose": "^5.9.0",
    "nodemailer": "^7.0.7",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/nodemailer": "^6.4.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
