# LiteLLM Gateway secrets.
# Copy to .env and fill in real values.
# DO NOT commit .env to git.

# ---------- Postgres ----------
# Strong random password for the embedded Postgres.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- LiteLLM ----------
# Master key for admin operations (creating virtual keys, querying spend).
# Used ONLY by the Billing service, never exposed to clients.
# Generate: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# Salt for encrypting virtual keys at rest in Postgres.
# Generate: openssl rand -hex 32
LITELLM_SALT_KEY=

# ---------- AI Providers ----------
# Anthropic: from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GigaChat (Sber): base64(client_id:client_secret) from https://developers.sber.ru/studio
# Free tier: ~1M tokens/month. Generate locally:
#   echo -n "<client_id>:<client_secret>" | base64 -w 0
GIGACHAT_CREDENTIALS=

# YandexGPT (Yandex Cloud Foundation Models).
# 1. https://console.yandex.cloud — log in with Yandex ID
# 2. Create or use a folder, note YANDEX_FOLDER_ID (e.g. b1gXXXXXXXXXXXXXXXXX)
# 3. IAM → Service accounts → create with role ai.languageModels.user
# 4. Generate API key for that service account → YANDEX_API_KEY
# Free quota for new accounts: ~1M tokens.
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
