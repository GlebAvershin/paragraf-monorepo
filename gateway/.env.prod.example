# Gateway production env (ТЗ-06).
# Скопировать в .env.prod на проде, заполнить, НИКОГДА не коммитить.

# === Caddy / TLS ===
GATEWAY_DOMAIN=gateway.paragraf-llm.com
# Опциональный резервный домен — на случай блокировки основного (план §9.2).
GATEWAY_DOMAIN_FALLBACK=
ACME_EMAIL=admin@paragraf.app

# === Postgres (внутренний, без публичных портов) ===
POSTGRES_PASSWORD=__GENERATE_openssl_rand_base64_32__

# === LiteLLM ===
# Главный мастер-ключ. ТОЛЬКО billing-сервис его знает. НИКОГДА не передавать
# в desktop-сборку. Ротация описана в docs/DEPLOY.md.
LITELLM_MASTER_KEY=sk-__GENERATE_openssl_rand_hex_32__
LITELLM_SALT_KEY=__GENERATE_openssl_rand_hex_32__

# === LLM-провайдеры ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# GigaChat: base64(client_id:client_secret) — не сырые значения.
GIGACHAT_CREDENTIALS=
# YandexGPT (опционально):
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# === Алерты ===
# Slack webhook для spend-алертов и health-уведомлений.
SLACK_WEBHOOK_URL=

# === S3 для бэкапов (вне-РФ хранилище) ===
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
BACKUP_S3_BUCKET=paragraf-gateway-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
