# Движок Isaac (engine) — конфигурация.
# Скопируйте в .env и заполните реальными значениями. .env коммитить НЕЛЬЗЯ.

PORT=4096
LOG_LEVEL=info

# --- Аутентификация: верификация billing-JWT ---
# JWT_SECRET ДОЛЖЕН ПОБАЙТОВО СОВПАДАТЬ с billing/.env — движок проверяет токены,
# которые выдаёт billing. Сгенерируйте ОДИН раз и вставьте в ОБА файла:
#   openssl rand -hex 64
JWT_SECRET=
# issuer / audience — те же значения, что в billing/.env (иначе verify отклонит токен).
JWT_ISSUER=billing.local
JWT_AUDIENCE=ourapp-desktop

# --- Внешние сервисы ---
# LiteLLM-шлюз (отдельный репозиторий paragraf-gateway). Движок проксирует
# запросы к моделям сюда. Движок шлёт СЫРОЙ текст в gateway-app (app-слой :4100),
# а не напрямую в LiteLLM. Раньше переменная звалась GATEWAY_URL.
ANSWER_URL=http://localhost:4100
# Общий секрет с gateway-app: движок шлёт его заголовком X-Internal-Key, шлюз
# принимает только запросы с ним. ДОЛЖЕН совпадать с GATEWAY_API_SECRET в app/.env
# репозитория paragraf-gateway. Пусто -> заголовок не шлём (dev, шлюз тоже без проверки).
# Сгенерировать: bun -e 'console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("hex"))'
GATEWAY_API_SECRET=
# Billing-сервис (auth/кредиты). На Windows используйте 127.0.0.1, НЕ localhost
# (Bun на Windows не резолвит localhost для исходящих запросов в части случаев).
BILLING_URL=http://127.0.0.1:3000

# --- gost-rag (база знаний ГОСТ) — заземление ответов помощника инженера ---
# Движок дёргает /retrieve, подмешивает выдержки ГОСТ в системный промпт и отдаёт источники в UI.
# Генерация остаётся на шлюзе с ключом юзера → биллинг считается как обычно. Запуск: make gost-rag.
GOST_RAG_URL=http://localhost:8000
# true → заземлять ВСЕ запросы (выделенный инженерный деплой); false → только при agent="gost".
GOST_RAG_ENABLED=false
# top_score ниже порога → честный abstain («в базе ГОСТ не найдено»). 0 = abstain только при пустой выдаче.
GOST_MIN_SCORE=0
# сколько выдержек подмешивать в контекст (баланс точность ↔ стоимость токенов).
GOST_TOP_K=8

# --- База данных (Postgres, РФ-юрисдикция для 152-ФЗ) ---
DATABASE_URL=postgres://engine:engine@localhost:5434/engine

# --- CORS (прод) ---
# Публичный домен веб-фронта — добавляется в allowlist (наравне с localhost/
# 127.0.0.1, которые разрешены всегда для dev). Пусто -> только localhost/127.0.0.1
# (и same-origin) проходят; чужой Origin получит ответ БЕЗ Access-Control-Allow-Origin.
WEB_PUBLIC_URL=
